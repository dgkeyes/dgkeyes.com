{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dgkeyes-com",
  "compatibility_date": "2026-08-28",
  // Static site only: no Worker script, Cloudflare serves the Astro build directly.
  "assets": {
    "directory": "./dist",
    // Serve /posts/twitter from posts/twitter.html and strip trailing slashes.
    "html_handling": "auto-trailing-slash",
    // Serve dist/404.html with a 404 status for unknown paths.
    "not_found_handling": "404-page"
  }
}
